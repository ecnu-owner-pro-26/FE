.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.search-wrap {
  position: relative;
  background: #fff;
  padding: 20rpx 24rpx 12rpx;
}

.search-input {
  height: 72rpx;
  border-radius: 36rpx;
  background: #f2f3f5;
  padding: 0 120rpx 0 26rpx;
  font-size: 26rpx;
  color: #333;
}

.search-clear {
  position: absolute;
  right: 48rpx;
  top: 38rpx;
  font-size: 24rpx;
  color: #a41f35;
}

.topic-filter-bar {
  background: #fff8f8;
  border-top: 1rpx solid #fde6ea;
  border-bottom: 1rpx solid #fde6ea;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topic-filter-text {
  font-size: 24rpx;
  color: #a41f35;
}

.topic-filter-clear {
  font-size: 24rpx;
  color: #666;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 12rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  justify-content: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.f-item {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.f-item.active {
  background: #a41f35;
  color: #fff;
  font-weight: bold;
}

.rank-tabs {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #efefef;
}

.rank-tab {
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
  border-bottom: 4rpx solid transparent;
}

.rank-tab.active {
  color: #a41f35;
  border-color: #a41f35;
  font-weight: 600;
}

/* 列表容器：解决“树洞没了”的高度问题 */
.list-wrap { 
  flex: 1; 
  height: 0; /* 关键：触发 flex 伸缩逻辑 */
}

.memory-list {
  padding: 24rpx 28rpx 120rpx;
}

.rank-item {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  margin: 18rpx 0;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rank-no {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  background: #a41f35;
  flex-shrink: 0;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.rank-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.rank-meta {
  margin-top: 16rpx;
  display: flex;
  gap: 22rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #888;
}

.status {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #999;
}

.more-btn {
  display: inline-block;
  margin: 12rpx auto 6rpx;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid #a41f35;
  color: #a41f35;
  font-size: 24rpx;
}