/**
 * 全局样式规范
 * 使用 CSS 变量管理品牌色，对齐工业化视觉维护模式
 */
 page {
  /* 华师大品牌色 */
  --ecnu-red: #a41f35;
  --ecnu-blue: #003366;
  --bg-gray: #f8f8f8;
  --text-main: #333333;
  --text-sec: #999999;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-gray);
}

.main-map {
  width: 100%;
  flex: 1;
  position: relative;
}

/* 按钮组定位 */
.btns-l, .btns-r { 
  position: absolute; 
  bottom: 60rpx; 
  display: flex; 
  flex-direction: column;
  gap: 20rpx; 
}
.btns-l { left: 30rpx; }
.btns-r { right: 30rpx; }

/* 传送按钮：使用变量 */
.nav-btn {
  background: #fff; 
  color: var(--ecnu-red);
  padding: 15rpx 25rpx;
  border-radius: 8rpx; 
  font-size: 24rpx; 
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1); 
  text-align: center;
}
.nav-btn.dsh { color: var(--ecnu-blue); }

/* 圆形功能键 */
.circ {
  width: 90rpx; 
  height: 90rpx; 
  border-radius: 45rpx;
  background: #fff; 
  display: flex; 
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.2);
}
.post { background: var(--ecnu-red); }

/* 字符图标样式 */
.itxt { color: var(--ecnu-red); font-size: 50rpx; font-weight: bold; line-height: 90rpx; }
.iplus { color: #fff; font-size: 60rpx; line-height: 80rpx; }