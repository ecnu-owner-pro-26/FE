/* 自定义 tabBar：底栏字号调大、品牌色 */
.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 88rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tab-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #a41f35;
  font-weight: bold;
}
