.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  justify-content: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.f-item {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.f-item.active {
  background: #a41f35;
  color: #fff;
  font-weight: bold;
}

/* 列表容器：解决“树洞没了”的高度问题 */
.list-wrap { 
  flex: 1; 
  height: 0; /* 关键：触发 flex 伸缩逻辑 */
}

.memory-list {
  padding: 24rpx 28rpx 120rpx;
}

.status { text-align: center; padding: 40rpx; font-size: 24rpx; color: #999; }