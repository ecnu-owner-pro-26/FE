<view class="container">
  <view class="header-section">
    <image class="main-bg" 
           src="{{userInfo.bgImage || 'https://images.unsplash.com/photo-1518173946687-a4c8a9b746f5'}}" 
           mode="aspectFill" 
           bindtap="changeBackground"></image>
    <view class="bg-mask"></view>
    
    <view class="user-card-wrap" wx:if="{{isLoggedIn}}" bindtap="goToEdit">
      <view class="avatar-group">
        <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
        <view class="edit-badge-inner">✎</view>
      </view>
      <view class="user-text">
        <text class="user-name">{{userInfo.nickname}}</text>
        <text class="user-bio">{{userInfo.bio || '有趣的人，总会相遇'}}</text>
      </view>
    </view>
    <view class="user-card-wrap" wx:else bindtap="goToLogin">
      <view class="user-text">
        <text class="user-name">未登录</text>
        <text class="user-bio">登录后查看个人资料</text>
      </view>
    </view>
  </view>

  <view class="float-stats-bar">
    <view class="stat-unit" bindtap="scrollToContent">
      <text class="stat-num">{{stats.postCount}}</text>
      <text class="stat-name">发布</text>
    </view>
    <view class="divider"></view>
    <view class="stat-unit" bindtap="navToLikes">
      <view class="num-wrapper">
        <text class="stat-num">{{stats.likeCount}}</text>
        <view class="red-dot" wx:if="{{unreadLikes > 0}}">{{unreadLikes}}</view>
      </view>
      <text class="stat-name">获赞</text>
    </view>
    <view class="divider"></view>
    <view class="stat-unit" bindtap="navToReceivedComments">
      <view class="num-wrapper">
        <text class="stat-num">{{stats.msgCount}}</text>
        <view class="red-dot" wx:if="{{unreadComments > 0}}">{{unreadComments}}</view>
      </view>
      <text class="stat-name">消息</text>
    </view>
  </view>

  <view class="content-area" id="content-nodes">
    <view class="sticky-tabs">
      <view class="tab-box {{currentTab == 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
        <text>我的帖子</text>
        <view class="tab-indicator"></view>
      </view>
      <view class="tab-box {{currentTab == 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
        <text>参与评论</text>
        <view class="tab-indicator"></view>
      </view>
    </view>

    <view class="post-list">
      <block wx:if="{{displayList.length > 0}}">
        <view class="luxury-card" wx:for="{{displayList}}" wx:key="id" bindtap="handleItemTap" data-id="{{item.id}}" data-postid="{{item.postId}}">
          <view class="card-body">
            <text class="card-title">{{item.title}}</text>
          </view>
          <view class="card-foot">
            <view class="foot-left">
              <text class="foot-time">{{item.time}}</text>
            </view>
            <view class="foot-right">
              <text class="btn-detail">{{currentTab == 0 ? item.likes + ' 赞' : '查看详情'}}</text>
            </view>
          </view>
        </view>
      </block>
      <view class="empty-status" wx:else>
        <image src="/assets/empty.png" mode="aspectFit" class="empty-img"></image>
        <text class="empty-text">还没有留下足迹呢</text>
      </view>
    </view>
  </view>
</view>