.container { min-height: 100vh; background: #f7f8fa; }

/* 头部视觉 */
.profile-header {
  position: relative; height: 560rpx;
  display: flex; flex-direction: column; justify-content: flex-start;
  padding-top: 180rpx; overflow: hidden;
}

.blur-bg {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  filter: blur(40rpx) brightness(0.8); transform: scale(1.2); z-index: 1;
}

.mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(164,31,53,0.4) 100%);
  z-index: 2;
}

.header-content {
  position: relative; z-index: 3; display: flex; flex-direction: column;
  align-items: center; padding: 0 40rpx;
}

.avatar-wrapper { position: relative; margin-bottom: 20rpx; }

.profile-avatar {
  width: 160rpx; height: 160rpx; border-radius: 80rpx;
  border: 6rpx solid rgba(255,255,255,0.4); box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
}

.gender-tag {
  position: absolute; bottom: 5rpx; right: 5rpx;
  width: 40rpx; height: 40rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff;
}
.male { background: #4dabf7; }
.female { background: #ff92ad; }

.profile-name { font-size: 44rpx; font-weight: bold; color: #fff; text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.3); }
.id-tag { font-size: 22rpx; color: rgba(255,255,255,0.8); background: rgba(0,0,0,0.2); padding: 2rpx 16rpx; border-radius: 20rpx; margin-top: 10rpx; }
.profile-bio { font-size: 26rpx; color: #eee; margin-top: 20rpx; text-align: center; line-height: 1.5; }

/* 悬浮统计卡片 */
.stats-card {
  position: absolute; bottom: -20rpx; left: 40rpx; right: 40rpx;
  height: 140rpx; background: #fff; border-radius: 30rpx; z-index: 10;
  display: flex; align-items: center; box-shadow: 0 15rpx 40rpx rgba(0,0,0,0.08);
}

.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-item .num { font-size: 36rpx; font-weight: bold; color: #A41F35; }
.stat-item .label { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.stat-divider { width: 1rpx; height: 60rpx; background: #eee; }

/* 列表区 */
.content-section { padding: 80rpx 30rpx 40rpx; }
.section-header { margin-bottom: 30rpx; display: flex; align-items: center; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin-right: 20rpx; }
.line { flex: 1; height: 2rpx; background: linear-gradient(to right, #A41F35, transparent); }

.memory-item { display: flex; margin-bottom: 40rpx; }
.memory-time { width: 100rpx; display: flex; flex-direction: column; align-items: center; padding-top: 10rpx; }
.memory-time .day { font-size: 36rpx; font-weight: bold; color: #333; }
.memory-time .month { font-size: 20rpx; color: #999; text-transform: uppercase; }

.memory-main { flex: 1; }
.memory-card {
  background: #fff; padding: 30rpx; border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.memory-content { font-size: 28rpx; color: #444; line-height: 1.6; }
.memory-footer { margin-top: 20rpx; display: flex; justify-content: space-between; font-size: 22rpx; color: #bbb; }